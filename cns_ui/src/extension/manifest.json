{
    "manifest_version": 3,
    "name": "CNS Executor",
    "version": "0.1.0",
    "description": "CNS Browser Extension for DOM Execution",
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}